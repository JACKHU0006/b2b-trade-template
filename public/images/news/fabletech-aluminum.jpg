<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="aluminumGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3b82f6"/>
      <stop offset="50%" style="stop-color:#60a5fa"/>
      <stop offset="100%" style="stop-color:#3b82f6"/>
    </linearGradient>
    <linearGradient id="aluminumShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff"/>
      <stop offset="50%" style="stop-color:#e0f2fe"/>
      <stop offset="100%" style="stop-color:#93c5fd"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#aluminumGrad)"/>
  
  <polygon points="400,150 550,250 550,400 400,500 250,400 250,250" fill="url(#aluminumShine)" opacity="0.3"/>
  <polygon points="400,180 510,270 510,370 400,440 290,370 290,270" fill="url(#aluminumShine)" opacity="0.2"/>
  
  <rect x="350" y="250" width="100" height="80" fill="url(#aluminumShine)" opacity="0.5"/>
  <rect x="350" y="340" width="100" height="60" fill="url(#aluminumShine)" opacity="0.4"/>
  
  <circle cx="320" cy="320" r="30" fill="url(#aluminumShine)" opacity="0.3"/>
  <circle cx="480" cy="320" r="30" fill="url(#aluminumShine)" opacity="0.3"/>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Aluminum Excellence</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#e0f2fe" text-anchor="middle">FableTech Group</text>
</svg>
