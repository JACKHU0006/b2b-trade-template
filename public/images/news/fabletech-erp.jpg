<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="erpGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f172a"/>
      <stop offset="50%" style="stop-color:#1e293b"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
    <linearGradient id="erpShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e2e8f0"/>
      <stop offset="50%" style="stop-color:#94a3b8"/>
      <stop offset="100%" style="stop-color:#64748b"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#erpGrad)"/>
  
  <rect x="200" y="200" width="180" height="200" rx="10" fill="url(#erpShine)" opacity="0.15"/>
  <rect x="420" y="200" width="180" height="200" rx="10" fill="url(#erpShine)" opacity="0.15"/>
  
  <rect x="220" y="230" width="140" height="25" rx="4" fill="url(#erpShine)" opacity="0.3"/>
  <rect x="220" y="270" width="100" height="20" rx="3" fill="url(#erpShine)" opacity="0.25"/>
  <rect x="220" y="305" width="120" height="20" rx="3" fill="url(#erpShine)" opacity="0.25"/>
  <rect x="220" y="340" width="80" height="20" rx="3" fill="url(#erpShine)" opacity="0.25"/>
  
  <rect x="440" y="230" width="140" height="25" rx="4" fill="url(#erpShine)" opacity="0.3"/>
  <rect x="440" y="270" width="100" height="20" rx="3" fill="url(#erpShine)" opacity="0.25"/>
  <rect x="440" y="305" width="120" height="20" rx="3" fill="url(#erpShine)" opacity="0.25"/>
  <rect x="440" y="340" width="80" height="20" rx="3" fill="url(#erpShine)" opacity="0.25"/>
  
  <path d="M380,300 L420,300" stroke="url(#erpShine)" stroke-width="3" opacity="0.4" marker-end="url(#arrow)"/>
  
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="url(#erpShine)" opacity="0.5"/>
    </marker>
  </defs>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">ERP System</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#e2e8f0" text-anchor="middle">Digital Transformation</text>
  <text x="400" y="585" font-family="Arial, sans-serif" font-size="14" fill="#e2e8f0" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
