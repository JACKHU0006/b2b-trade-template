<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="dubaiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c3aed"/>
      <stop offset="50%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#7c3aed"/>
    </linearGradient>
    <linearGradient id="dubaiShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f5f3ff"/>
      <stop offset="50%" style="stop-color:#e9d5ff"/>
      <stop offset="100%" style="stop-color:#d8b4fe"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#dubaiGrad)"/>
  
  <polygon points="350,150 360,300 380,300 370,150" fill="url(#dubaiShine)" opacity="0.5"/>
  <polygon points="400,100 410,350 430,350 420,100" fill="url(#dubaiShine)" opacity="0.6"/>
  <polygon points="450,120 460,280 480,280 470,120" fill="url(#dubaiShine)" opacity="0.45"/>
  
  <rect x="300" y="350" width="200" height="80" rx="5" fill="url(#dubaiShine)" opacity="0.2"/>
  
  <text x="400" y="400" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#7c3aed" text-anchor="middle">DUBAI WAREHOUSE</text>
  
  <text x="400" y="500" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Dubai Hub</text>
  <text x="400" y="540" font-family="Arial, sans-serif" font-size="20" fill="#f5f3ff" text-anchor="middle">Middle East Expansion</text>
  <text x="400" y="570" font-family="Arial, sans-serif" font-size="14" fill="#f5f3ff" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
