<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="asiaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#dc2626"/>
      <stop offset="50%" style="stop-color:#ef4444"/>
      <stop offset="100%" style="stop-color:#dc2626"/>
    </linearGradient>
    <linearGradient id="asiaShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fee2e2"/>
      <stop offset="50%" style="stop-color:#fca5a5"/>
      <stop offset="100%" style="stop-color:#f87171"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#asiaGrad)"/>
  
  <circle cx="250" cy="280" r="50" fill="url(#asiaShine)" opacity="0.3"/>
  <circle cx="400" cy="350" r="60" fill="url(#asiaShine)" opacity="0.25"/>
  <circle cx="550" cy="250" r="45" fill="url(#asiaShine)" opacity="0.3"/>
  <circle cx="350" cy="400" r="40" fill="url(#asiaShine)" opacity="0.25"/>
  <circle cx="500" cy="400" r="35" fill="url(#asiaShine)" opacity="0.25"/>
  
  <circle cx="250" cy="280" r="15" fill="url(#asiaShine)" opacity="0.6"/>
  <circle cx="400" cy="350" r="18" fill="url(#asiaShine)" opacity="0.6"/>
  <circle cx="550" cy="250" r="12" fill="url(#asiaShine)" opacity="0.6"/>
  <circle cx="350" cy="400" r="10" fill="url(#asiaShine)" opacity="0.6"/>
  <circle cx="500" cy="400" r="10" fill="url(#asiaShine)" opacity="0.6"/>
  
  <path d="M250,280 Q400,300 400,350 Q380,400 350,400" stroke="url(#asiaShine)" stroke-width="2" fill="none" opacity="0.4"/>
  <path d="M400,350 Q450,320 550,250" stroke="url(#asiaShine)" stroke-width="2" fill="none" opacity="0.4"/>
  <path d="M400,350 Q450,380 500,400" stroke="url(#asiaShine)" stroke-width="2" fill="none" opacity="0.4"/>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Southeast Asia</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#fee2e2" text-anchor="middle">FableTech Group Expansion</text>
</svg>
