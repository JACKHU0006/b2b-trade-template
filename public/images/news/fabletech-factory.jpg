<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="factoryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#065f46"/>
      <stop offset="50%" style="stop-color:#0d9488"/>
      <stop offset="100%" style="stop-color:#065f46"/>
    </linearGradient>
    <linearGradient id="factoryShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d1fae5"/>
      <stop offset="50%" style="stop-color:#6ee7b7"/>
      <stop offset="100%" style="stop-color:#34d399"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#factoryGrad)"/>
  
  <rect x="150" y="200" width="120" height="180" fill="url(#factoryShine)" opacity="0.3"/>
  <rect x="280" y="150" width="140" height="230" fill="url(#factoryShine)" opacity="0.25"/>
  <rect x="430" y="180" width="120" height="200" fill="url(#factoryShine)" opacity="0.3"/>
  <rect x="560" y="220" width="100" height="160" fill="url(#factoryShine)" opacity="0.25"/>
  
  <rect x="170" y="240" width="30" height="60" fill="url(#factoryShine)" opacity="0.5"/>
  <rect x="210" y="240" width="30" height="60" fill="url(#factoryShine)" opacity="0.45"/>
  
  <rect x="300" y="200" width="40" height="80" fill="url(#factoryShine)" opacity="0.5"/>
  <rect x="350" y="200" width="40" height="80" fill="url(#factoryShine)" opacity="0.45"/>
  <rect x="400" y="200" width="40" height="80" fill="url(#factoryShine)" opacity="0.5"/>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Modern Manufacturing</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#d1fae5" text-anchor="middle">FableTech Group</text>
</svg>
