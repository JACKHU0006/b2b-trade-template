<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="trainingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#164e63"/>
      <stop offset="50%" style="stop-color:#14b8a6"/>
      <stop offset="100%" style="stop-color:#164e63"/>
    </linearGradient>
    <linearGradient id="trainingShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#cffafe"/>
      <stop offset="50%" style="stop-color:#67e8f9"/>
      <stop offset="100%" style="stop-color:#22d3ee"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#trainingGrad)"/>
  
  <rect x="250" y="200" width="300" height="220" rx="15" fill="url(#trainingShine)" opacity="0.15"/>
  
  <circle cx="350" cy="260" r="25" fill="url(#trainingShine)" opacity="0.4"/>
  <path d="M342,260 L350,250 L358,260 L350,275 Z" fill="white" opacity="0.6"/>
  
  <rect x="400" y="240" width="120" height="25" rx="4" fill="url(#trainingShine)" opacity="0.3"/>
  <rect x="400" y="280" width="100" height="20" rx="3" fill="url(#trainingShine)" opacity="0.25"/>
  <rect x="400" y="315" width="90" height="20" rx="3" fill="url(#trainingShine)" opacity="0.25"/>
  <rect x="400" y="350" width="110" height="20" rx="3" fill="url(#trainingShine)" opacity="0.25"/>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Employee Training</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="20" fill="#cffafe" text-anchor="middle">Skills Development Program</text>
  <text x="400" y="550" font-family="Arial, sans-serif" font-size="14" fill="#cffafe" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
