<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="catalogGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#312e81"/>
      <stop offset="50%" style="stop-color:#4f46e5"/>
      <stop offset="100%" style="stop-color:#312e81"/>
    </linearGradient>
    <linearGradient id="catalogShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e7ff"/>
      <stop offset="50%" style="stop-color:#a5b4fc"/>
      <stop offset="100%" style="stop-color:#818cf8"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#catalogGrad)"/>
  
  <rect x="200" y="180" width="180" height="240" rx="10" fill="url(#catalogShine)" opacity="0.15"/>
  <rect x="420" y="180" width="180" height="240" rx="10" fill="url(#catalogShine)" opacity="0.15"/>
  
  <rect x="220" y="210" width="140" height="60" rx="5" fill="url(#catalogShine)" opacity="0.3"/>
  <rect x="220" y="285" width="100" height="30" rx="3" fill="url(#catalogShine)" opacity="0.25"/>
  <rect x="220" y="330" width="120" height="30" rx="3" fill="url(#catalogShine)" opacity="0.25"/>
  
  <rect x="440" y="210" width="140" height="60" rx="5" fill="url(#catalogShine)" opacity="0.3"/>
  <rect x="440" y="285" width="100" height="30" rx="3" fill="url(#catalogShine)" opacity="0.25"/>
  <rect x="440" y="330" width="120" height="30" rx="3" fill="url(#catalogShine)" opacity="0.25"/>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Online Catalog</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#e0e7ff" text-anchor="middle">5,000+ Products</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="14" fill="#e0e7ff" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
