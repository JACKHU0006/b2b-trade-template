<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af"/>
      <stop offset="100%" style="stop-color:#3b82f6"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#bg)"/>
  <rect x="200" y="150" width="400" height="300" rx="20" fill="white" opacity="0.1"/>
  <rect x="230" y="180" width="340" height="240" rx="10" fill="white" opacity="0.2"/>
  <text x="400" y="280" font-family="Arial" font-size="24" font-weight="bold" fill="white" text-anchor="middle">Online Catalog</text>
  <text x="400" y="350" font-family="Arial" font-size="36" font-weight="bold" fill="white" text-anchor="middle">5,000+ Products</text>
  <text x="400" y="480" font-family="Arial" font-size="18" fill="white" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
