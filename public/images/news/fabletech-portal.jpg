<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="portalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#312e81"/>
      <stop offset="50%" style="stop-color:#4f46e5"/>
      <stop offset="100%" style="stop-color:#312e81"/>
    </linearGradient>
    <linearGradient id="portalShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e7ff"/>
      <stop offset="50%" style="stop-color:#a5b4fc"/>
      <stop offset="100%" style="stop-color:#818cf8"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#portalGrad)"/>
  
  <rect x="200" y="180" width="160" height="180" rx="10" fill="url(#portalShine)" opacity="0.15"/>
  <rect x="220" y="200" width="120" height="140" rx="8" fill="url(#portalShine)" opacity="0.1"/>
  
  <rect x="440" y="180" width="160" height="180" rx="10" fill="url(#portalShine)" opacity="0.15"/>
  <rect x="460" y="200" width="120" height="140" rx="8" fill="url(#portalShine)" opacity="0.1"/>
  
  <circle cx="280" cy="250" r="20" fill="url(#portalShine)" opacity="0.4"/>
  <rect x="270" y="280" width="20" height="40" rx="3" fill="url(#portalShine)" opacity="0.3"/>
  
  <rect x="500" y="220" width="40" height="40" rx="5" fill="url(#portalShine)" opacity="0.3"/>
  <rect x="500" y="270" width="40" height="30" rx="3" fill="url(#portalShine)" opacity="0.25"/>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Documentation Portal</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="20" fill="#e0e7ff" text-anchor="middle">Technical Resources</text>
  <text x="400" y="550" font-family="Arial, sans-serif" font-size="14" fill="#e0e7ff" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
