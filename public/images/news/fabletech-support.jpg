<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="supportGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f766e"/>
      <stop offset="50%" style="stop-color:#14b8a6"/>
      <stop offset="100%" style="stop-color:#0f766e"/>
    </linearGradient>
    <linearGradient id="supportShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ccfbf1"/>
      <stop offset="50%" style="stop-color:#5eead4"/>
      <stop offset="100%" style="stop-color:#2dd4bf"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#supportGrad)"/>
  
  <path d="M300,300 L350,250 L500,380 L350,400 Z" fill="url(#supportShine)" opacity="0.3"/>
  
  <rect x="320" y="220" width="160" height="100" rx="10" fill="url(#supportShine)" opacity="0.25"/>
  <rect x="340" y="240" width="120" height="25" rx="3" fill="url(#supportShine)" opacity="0.4"/>
  <rect x="340" y="280" width="120" height="25" rx="3" fill="url(#supportShine)" opacity="0.3"/>
  <rect x="340" y="320" width="120" height="25" rx="3" fill="url(#supportShine)" opacity="0.3"/>
  
  <circle cx="550" cy="250" r="30" fill="url(#supportShine)" opacity="0.2"/>
  <circle cx="565" cy="235" r="10" fill="url(#supportShine)" opacity="0.5"/>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">24/7 Support</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="20" fill="#ccfbf1" text-anchor="middle">Multilingual Support Team</text>
  <text x="400" y="550" font-family="Arial, sans-serif" font-size="14" fill="#ccfbf1" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
