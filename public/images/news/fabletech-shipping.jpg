<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="shipGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af"/>
      <stop offset="50%" style="stop-color:#3b82f6"/>
      <stop offset="100%" style="stop-color:#1e40af"/>
    </linearGradient>
    <linearGradient id="shipShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0f2fe"/>
      <stop offset="50%" style="stop-color:#93c5fd"/>
      <stop offset="100%" style="stop-color:#60a5fa"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#shipGrad)"/>
  
  <path d="M100,400 Q200,350 400,380 Q600,410 700,360" stroke="url(#shipShine)" stroke-width="3" fill="none" opacity="0.5"/>
  <path d="M150,420 Q250,380 400,400 Q550,420 650,380" stroke="url(#shipShine)" stroke-width="2" fill="none" opacity="0.3"/>
  
  <rect x="320" y="300" width="160" height="80" fill="url(#shipShine)" opacity="0.4"/>
  <polygon points="350,380 400,330 450,380" fill="url(#shipShine)" opacity="0.5"/>
  <rect x="380" y="250" width="40" height="50" fill="url(#shipShine)" opacity="0.5"/>
  
  <circle cx="200" cy="250" r="40" fill="url(#shipShine)" opacity="0.2"/>
  <circle cx="600" cy="200" r="30" fill="url(#shipShine)" opacity="0.2"/>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Global Shipping</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#e0f2fe" text-anchor="middle">FableTech Group</text>
</svg>
