<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="certGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c3aed"/>
      <stop offset="50%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#7c3aed"/>
    </linearGradient>
    <linearGradient id="certShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f5f3ff"/>
      <stop offset="50%" style="stop-color:#e9d5ff"/>
      <stop offset="100%" style="stop-color:#d8b4fe"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#certGrad)"/>
  
  <circle cx="400" cy="300" r="180" fill="url(#certShine)" opacity="0.15"/>
  <circle cx="400" cy="300" r="140" fill="url(#certShine)" opacity="0.1"/>
  <circle cx="400" cy="300" r="100" fill="url(#certShine)" opacity="0.05"/>
  
  <polygon points="400,160 430,240 520,240 450,290 470,380 400,330 330,380 350,290 280,240 370,240" fill="url(#certShine)" opacity="0.4"/>
  
  <rect x="350" y="280" width="100" height="60" fill="url(#certShine)" opacity="0.3"/>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Quality Certified</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#e9d5ff" text-anchor="middle">FableTech Group</text>
</svg>
