<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#065f46"/>
      <stop offset="50%" style="stop-color:#0d9488"/>
      <stop offset="100%" style="stop-color:#065f46"/>
    </linearGradient>
    <linearGradient id="greenShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d1fae5"/>
      <stop offset="50%" style="stop-color:#6ee7b7"/>
      <stop offset="100%" style="stop-color:#34d399"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#greenGrad)"/>
  
  <path d="M300,350 L350,250 L400,350 L450,250 L500,350" stroke="url(#greenShine)" stroke-width="8" fill="none" opacity="0.5"/>
  
  <circle cx="350" cy="200" r="30" fill="url(#greenShine)" opacity="0.6"/>
  <circle cx="450" cy="200" r="30" fill="url(#greenShine)" opacity="0.6"/>
  
  <text x="400" y="460" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Renewable Energy</text>
  <text x="400" y="500" font-family="Arial, sans-serif" font-size="20" fill="#d1fae5" text-anchor="middle">Green Partnership</text>
  <text x="400" y="530" font-family="Arial, sans-serif" font-size="14" fill="#d1fae5" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
