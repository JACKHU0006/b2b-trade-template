<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="rdGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c3aed"/>
      <stop offset="50%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#7c3aed"/>
    </linearGradient>
    <linearGradient id="rdShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f5f3ff"/>
      <stop offset="50%" style="stop-color:#e9d5ff"/>
      <stop offset="100%" style="stop-color:#d8b4fe"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#rdGrad)"/>
  
  <circle cx="400" cy="300" r="100" fill="url(#rdShine)" opacity="0.2"/>
  <circle cx="400" cy="300" r="60" fill="url(#rdShine)" opacity="0.15"/>
  
  <rect x="300" y="200" width="60" height="100" fill="url(#rdShine)" opacity="0.3"/>
  <rect x="380" y="180" width="40" height="120" fill="url(#rdShine)" opacity="0.35"/>
  <rect x="460" y="210" width="60" height="90" fill="url(#rdShine)" opacity="0.3"/>
  
  <rect x="330" y="350" width="140" height="60" rx="5" fill="url(#rdShine)" opacity="0.25"/>
  <circle cx="360" cy="380" r="15" fill="url(#rdShine)" opacity="0.4"/>
  <rect x="400" y="370" width="60" height="20" rx="3" fill="url(#rdShine)" opacity="0.4"/>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">R&D Laboratory</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" fill="#e9d5ff" text-anchor="middle">FableTech Group</text>
</svg>
