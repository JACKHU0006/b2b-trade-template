<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="successGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#059669"/>
      <stop offset="50%" style="stop-color:#10b981"/>
      <stop offset="100%" style="stop-color:#059669"/>
    </linearGradient>
    <linearGradient id="successShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d1fae5"/>
      <stop offset="50%" style="stop-color:#6ee7b7"/>
      <stop offset="100%" style="stop-color:#34d399"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#successGrad)"/>
  
  <circle cx="400" cy="280" r="120" fill="url(#successShine)" opacity="0.1"/>
  
  <rect x="320" y="200" width="160" height="160" rx="10" fill="url(#successShine)" opacity="0.2"/>
  
  <circle cx="400" cy="280" r="30" fill="url(#successShine)" opacity="0.5"/>
  <path d="M385,280 L395,290 L420,265" stroke="white" stroke-width="6" fill="none" opacity="0.8" stroke-linecap="round" stroke-linejoin="round"/>
  
  <text x="400" y="440" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Customer Success</text>
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="20" fill="#d1fae5" text-anchor="middle">Support Center</text>
  <text x="400" y="510" font-family="Arial, sans-serif" font-size="14" fill="#d1fae5" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
