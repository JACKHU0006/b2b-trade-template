<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="qualityGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4f46e5"/>
      <stop offset="50%" style="stop-color:#6366f1"/>
      <stop offset="100%" style="stop-color:#4f46e5"/>
    </linearGradient>
    <linearGradient id="qualityShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0e7ff"/>
      <stop offset="50%" style="stop-color:#a5b4fc"/>
      <stop offset="100%" style="stop-color:#818cf8"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#qualityGrad)"/>
  
  <circle cx="400" cy="280" r="100" fill="url(#qualityShine)" opacity="0.15"/>
  
  <path d="M350,280 L380,320 L450,250 L380,280 L350,280" fill="url(#qualityShine)" opacity="0.5"/>
  
  <rect x="350" y="380" width="100" height="50" rx="8" fill="url(#qualityShine)" opacity="0.3"/>
  
  <text x="400" y="415" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#4f46e5" text-anchor="middle">EXCELLENCE</text>
  
  <text x="400" y="500" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Quality Award</text>
  <text x="400" y="540" font-family="Arial, sans-serif" font-size="20" fill="#e0e7ff" text-anchor="middle">3rd Consecutive Year</text>
  <text x="400" y="570" font-family="Arial, sans-serif" font-size="14" fill="#e0e7ff" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
