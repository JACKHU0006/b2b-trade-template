<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="carbonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#059669"/>
      <stop offset="50%" style="stop-color:#0d9488"/>
      <stop offset="100%" style="stop-color:#059669"/>
    </linearGradient>
    <linearGradient id="carbonShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d1fae5"/>
      <stop offset="50%" style="stop-color:#6ee7b7"/>
      <stop offset="100%" style="stop-color:#34d399"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#carbonGrad)"/>
  
  <circle cx="400" cy="280" r="100" fill="url(#carbonShine)" opacity="0.15"/>
  
  <path d="M300,280 L350,280 L350,330 L450,330 L450,280 L500,280" stroke="white" stroke-width="8" fill="none" opacity="0.7"/>
  
  <circle cx="400" cy="380" r="30" fill="white" opacity="0.3"/>
  <path d="M385,380 L395,380 L395,370" stroke="white" stroke-width="4" fill="none" opacity="0.7"/>
  
  <text x="400" y="460" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Carbon Neutral</text>
  <text x="400" y="500" font-family="Arial, sans-serif" font-size="20" fill="#d1fae5" text-anchor="middle">By 2030</text>
  <text x="400" y="530" font-family="Arial, sans-serif" font-size="14" fill="#d1fae5" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
