<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="europeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af"/>
      <stop offset="50%" style="stop-color:#3b82f6"/>
      <stop offset="100%" style="stop-color:#1e40af"/>
    </linearGradient>
    <linearGradient id="europeShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0f2fe"/>
      <stop offset="50%" style="stop-color:#93c5fd"/>
      <stop offset="100%" style="stop-color:#60a5fa"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#europeGrad)"/>
  
  <path d="M200,300 Q300,200 400,280 Q500,360 600,300" stroke="url(#europeShine)" stroke-width="4" fill="none" opacity="0.4"/>
  
  <circle cx="280" cy="260" r="40" fill="url(#europeShine)" opacity="0.3"/>
  <circle cx="420" cy="280" r="45" fill="url(#europeShine)" opacity="0.25"/>
  <circle cx="550" cy="320" r="35" fill="url(#europeShine)" opacity="0.3"/>
  
  <circle cx="280" cy="260" r="15" fill="url(#europeShine)" opacity="0.6"/>
  <circle cx="420" cy="280" r="18" fill="url(#europeShine)" opacity="0.6"/>
  <circle cx="550" cy="320" r="12" fill="url(#europeShine)" opacity="0.6"/>
  
  <path d="M280,260 Q350,270 420,280" stroke="url(#europeShine)" stroke-width="2" fill="none" opacity="0.5"/>
  <path d="M420,280 Q485,300 550,320" stroke="url(#europeShine)" stroke-width="2" fill="none" opacity="0.5"/>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">European Expansion</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="20" fill="#e0f2fe" text-anchor="middle">Distribution Network</text>
  <text x="400" y="550" font-family="Arial, sans-serif" font-size="14" fill="#e0f2fe" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
