<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="newProdGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af"/>
      <stop offset="50%" style="stop-color:#059669"/>
      <stop offset="100%" style="stop-color:#1e40af"/>
    </linearGradient>
    <linearGradient id="newProdShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e0f2fe"/>
      <stop offset="50%" style="stop-color:#6ee7b7"/>
      <stop offset="100%" style="stop-color:#34d399"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#newProdGrad)"/>
  
  <circle cx="400" cy="250" r="120" fill="url(#newProdShine)" opacity="0.15"/>
  
  <rect x="340" y="180" width="120" height="80" rx="10" fill="url(#newProdShine)" opacity="0.3"/>
  
  <text x="400" y="220" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1e40af" text-anchor="middle">NEW</text>
  <text x="400" y="245" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#059669" text-anchor="middle">PRODUCTS</text>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">New Products</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="20" fill="#e0f2fe" text-anchor="middle">Exciting Innovations</text>
  <text x="400" y="550" font-family="Arial, sans-serif" font-size="14" fill="#e0f2fe" text-anchor="middle" opacity="0.8">FableTech Group</text>
</svg>
