<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="steelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1f2937"/>
      <stop offset="50%" style="stop-color:#374151"/>
      <stop offset="100%" style="stop-color:#1f2937"/>
    </linearGradient>
    <linearGradient id="metalShine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff"/>
      <stop offset="50%" style="stop-color:#9ca3af"/>
      <stop offset="100%" style="stop-color:#374151"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#steelGrad)"/>
  
  <rect x="150" y="180" width="200" height="240" fill="url(#metalShine)" rx="8" opacity="0.3"/>
  <rect x="160" y="190" width="180" height="220" fill="url(#metalShine)" rx="6" opacity="0.2"/>
  
  <rect x="450" y="200" width="180" height="200" fill="url(#metalShine)" rx="8" opacity="0.25"/>
  <rect x="460" y="210" width="160" height="180" fill="url(#metalShine)" rx="6" opacity="0.15"/>
  
  <rect x="180" y="220" width="40" height="140" fill="url(#metalShine)" opacity="0.6"/>
  <rect x="230" y="220" width="40" height="120" fill="url(#metalShine)" opacity="0.5"/>
  <rect x="280" y="220" width="40" height="160" fill="url(#metalShine)" opacity="0.55"/>
  
  <rect x="480" y="240" width="50" height="100" fill="url(#metalShine)" opacity="0.5"/>
  <rect x="540" y="240" width="50" height="120" fill="url(#metalShine)" opacity="0.45"/>
  <rect x="600" y="240" width="50" height="90" fill="url(#metalShine)" opacity="0.55"/>
  
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="white" text-anchor="middle">Industrial Steel</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="18" fill="#9ca3af" text-anchor="middle">FableTech Group</text>
</svg>
