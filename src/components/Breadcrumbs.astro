---
interface BreadcrumbsProps {
  items: Array<{
    name: string;
    href: string;
  }>;
  locale?: string;
}

const { items, locale = 'en' } = Astro.props;

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.href.startsWith('http') ? item.href : `https://fabletech.example.com${item.href}`,
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex items-center space-x-2 text-sm">
    <li>
      <a href="/" class="text-gray-500 hover:text-primary transition-colors">
        Home
      </a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center">
        <span class="mx-2 text-gray-400">/</span>
        {index === items.length - 1 ? (
          <span class="text-gray-900 font-medium" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.href} class="text-gray-500 hover:text-primary transition-colors">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />
