---
import { Menu, X, Globe, User, Search } from '@lucide/astro';

interface HeaderProps {
  locale: string;
}

const { locale } = Astro.props;

const navItems = {
  en: [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/products', label: 'Products' },
    { href: '/news', label: 'News' },
    { href: '/factory', label: 'Factory' },
    { href: '/service', label: 'Service' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Contact' },
  ],
  de: [
    { href: '/', label: 'Startseite' },
    { href: '/about', label: 'Über uns' },
    { href: '/products', label: 'Produkte' },
    { href: '/news', label: 'Nachrichten' },
    { href: '/factory', label: 'Fabrik' },
    { href: '/service', label: 'Dienstleistung' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Kontakt' },
  ],
  fr: [
    { href: '/', label: 'Accueil' },
    { href: '/about', label: 'À propos' },
    { href: '/products', label: 'Produits' },
    { href: '/news', label: 'Nouvelles' },
    { href: '/factory', label: 'Usine' },
    { href: '/service', label: 'Service' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Contact' },
  ],
  es: [
    { href: '/', label: 'Inicio' },
    { href: '/about', label: 'Sobre nosotros' },
    { href: '/products', label: 'Productos' },
    { href: '/news', label: 'Noticias' },
    { href: '/factory', label: 'Fábrica' },
    { href: '/service', label: 'Servicio' },
    { href: '/faq', label: 'FAQ' },
    { href: '/contact', label: 'Contacto' },
  ],
  ar: [
    { href: '/', label: 'الرئيسية' },
    { href: '/about', label: 'عن الشركة' },
    { href: '/products', label: 'المنتجات' },
    { href: '/news', label: 'الأخبار' },
    { href: '/factory', label: 'المصنع' },
    { href: '/service', label: 'الخدمات' },
    { href: '/faq', label: 'أسئلة شائعة' },
    { href: '/contact', label: 'اتصل بنا' },
  ],
};

const locales = [
  { code: 'en', label: 'English', flag: '🇬🇧' },
  { code: 'de', label: 'Deutsch', flag: '🇩🇪' },
  { code: 'fr', label: 'Français', flag: '🇫🇷' },
  { code: 'es', label: 'Español', flag: '🇪🇸' },
  { code: 'ar', label: 'العربية', flag: '🇸🇦' },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
        <div class="flex items-center">
          <a href="/" class="flex-shrink-0">
            <svg width="100" height="36" viewBox="0 0 100 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" style="stop-color:#1e40af"/>
                  <stop offset="50%" style="stop-color:#059669"/>
                  <stop offset="100%" style="stop-color:#1e40af"/>
                </linearGradient>
              </defs>
              <text x="0" y="28" font-family="Inter, Arial, sans-serif" font-size="24" font-weight="700" fill="url(#logoGrad)">FableTech</text>
            </svg>
          </a>
        </div>

      <nav class="hidden md:flex items-center space-x-1">
        {navItems[locale as keyof typeof navItems].map((item) => (
          <a
            key={item.href}
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-md transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center space-x-4">
        <div class="relative">
          <button
            id="locale-button"
            class="flex items-center space-x-1 px-3 py-2 rounded-md text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors"
          >
            <Globe class="h-4 w-4" />
            <span class="text-sm font-medium">
              {locales.find(l => l.code === locale)?.flag} {locales.find(l => l.code === locale)?.label}
            </span>
          </button>
          <div id="locale-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-1 z-50 hidden">
            {locales.map((loc) => (
              <a
                key={loc.code}
                href="/"
                class={`flex items-center space-x-2 px-4 py-2 text-sm hover:bg-gray-50 ${locale === loc.code ? 'text-primary font-medium' : 'text-gray-700'}`}
              >
                <span>{loc.flag}</span>
                <span>{loc.label}</span>
              </a>
            ))}
          </div>
        </div>

        <button id="search-button" class="p-2 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-md transition-colors">
          <Search class="h-5 w-5" />
        </button>

        <a href="/auth/login" class="p-2 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-md transition-colors">
          <User class="h-5 w-5" />
        </a>

        <button
          id="mobile-menu-button"
          class="md:hidden p-2 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-md transition-colors"
        >
          <Menu class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden bg-white border-t hidden">
    <div class="px-2 pt-2 pb-3 space-y-1">
      {navItems[locale as keyof typeof navItems].map((item) => (
        <a
          key={item.href}
          href={item.href}
          class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-md"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<div id="search-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-start justify-center pt-20">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl mx-4">
    <div class="p-4">
      <div class="flex items-center space-x-4">
        <Search class="h-5 w-5 text-gray-400" />
        <input 
          type="text" 
          id="search-input"
          placeholder="Search products, news, pages..."
          class="flex-1 text-lg outline-none"
        />
        <button id="close-search" class="text-gray-400 hover:text-gray-600">
          <X class="h-5 w-5" />
        </button>
      </div>
    </div>
    <div id="search-results" class="border-t max-h-96 overflow-y-auto">
      <div class="p-4 text-gray-500 text-center">Type to search...</div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const localeButton = document.getElementById('locale-button');
    const localeDropdown = document.getElementById('locale-dropdown');
    
    if (localeButton && localeDropdown) {
      localeButton.addEventListener('click', (e) => {
        e.stopPropagation();
        localeDropdown.classList.toggle('hidden');
      });
    }

    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        const icon = mobileMenuButton.querySelector('svg');
        if (icon) {
          icon.classList.toggle('rotate-90');
        }
      });
    }

    document.addEventListener('click', (e) => {
      if (localeButton && localeDropdown && !localeButton.contains(e.target as Node)) {
        localeDropdown.classList.add('hidden');
      }
    });

    const searchButton = document.getElementById('search-button');
    const searchModal = document.getElementById('search-modal');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const closeSearch = document.getElementById('close-search');

    if (searchButton && searchModal) {
      searchButton.addEventListener('click', () => {
        searchModal.classList.remove('hidden');
        searchInput?.focus();
      });
    }

    if (closeSearch && searchModal) {
      closeSearch.addEventListener('click', () => {
        searchModal.classList.add('hidden');
      });
    }

    if (searchModal) {
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) {
          searchModal.classList.add('hidden');
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchModal) {
        searchModal.classList.add('hidden');
      }
      if (e.key === '/' && e.target.tagName !== 'INPUT') {
        e.preventDefault();
        searchModal?.classList.remove('hidden');
        searchInput?.focus();
      }
    });
  });
</script>
