---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <div class="lg:col-span-2">
        <div class="flex items-center mb-4">
          <div class="h-10 w-10 bg-primary rounded-full flex items-center justify-center">
            <span class="text-white font-bold text-xl">M</span>
          </div>
          <span class="ml-3 text-2xl font-bold">MetalWorks</span>
        </div>
        <p class="text-gray-400 mb-6 max-w-sm">
          {locale === 'en' && 'Leading manufacturer of industrial metal products. We provide high-quality steel, aluminum, copper, and titanium solutions worldwide.'}
          {locale === 'de' && 'Führender Hersteller von industriellen Metallprodukten. Wir liefern weltweit hochwertige Lösungen aus Stahl, Aluminium, Kupfer und Titan.'}
          {locale === 'fr' && 'Fabricant leader de produits métalliques industriels. Nous fournissons des solutions de haute qualité en acier, aluminium, cuivre et titane dans le monde entier.'}
          {locale === 'es' && 'Fabricante líder de productos metálicos industriales. Proporcionamos soluciones de alta calidad en acero, aluminio, cobre y titanio en todo el mundo.'}
          {locale === 'ar' && 'المنتج الرائد للمنتجات المعدنية الصناعية. نقدم حلول عالية الجودة من الفولاذ والألومنيوم والنحاس والتيتانيوم في جميع أنحاء العالم.'}
        </p>
        <div class="space-y-3">
          <div class="flex items-center text-gray-400">
            <MapPin class="h-5 w-5 mr-3 text-primary" />
            <span>{contactInfo[locale as keyof typeof contactInfo].address}</span>
          </div>
          <div class="flex items-center text-gray-400">
            <Phone class="h-5 w-5 mr-3 text-primary" />
            <span>{contactInfo[locale as keyof typeof contactInfo].phone}</span>
          </div>
          <div class="flex items-center text-gray-400">
            <Mail class="h-5 w-5 mr-3 text-primary" />
            <span>{contactInfo[locale as keyof typeof contactInfo].email}</span>
          </div>
          <div class="flex items-center text-gray-400">
            <Clock class="h-5 w-5 mr-3 text-primary" />
            <span>{contactInfo[locale as keyof typeof contactInfo].hours}</span>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4">{footerLinks[locale as keyof typeof footerLinks].company.title}</h3>
        <ul class="space-y-2">
          {footerLinks[locale as keyof typeof footerLinks].company.links.map((link) => (
            <li key={link.href}>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4">{footerLinks[locale as keyof typeof footerLinks].products.title}</h3>
        <ul class="space-y-2">
          {footerLinks[locale as keyof typeof footerLinks].products.links.map((link) => (
            <li key={link.href}>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4">{footerLinks[locale as keyof typeof footerLinks].support.title}</h3>
        <ul class="space-y-2">
          {footerLinks[locale as keyof typeof footerLinks].support.links.map((link) => (
            <li key={link.href}>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="flex space-x-4 mt-6">
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <Link2 class="h-5 w-5" />
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <MessageCircle class="h-5 w-5" />
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <Send class="h-5 w-5" />
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <Play class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-8 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <p class="text-gray-400 text-sm">
          {locale === 'en' && '2024 MetalWorks. All rights reserved.'}
          {locale === 'de' && '2024 MetalWorks. Alle Rechte vorbehalten.'}
          {locale === 'fr' && '2024 MetalWorks. Tous droits réservés.'}
          {locale === 'es' && '2024 MetalWorks. Todos los derechos reservados.'}
          {locale === 'ar' && '2024 MetalWorks. جميع الحقوق محفوظة.'}
        </p>
        <div class="flex space-x-6 mt-4 md:mt-0">
          {footerLinks[locale as keyof typeof footerLinks].legal.links.map((link) => (
            <a key={link.href} href={link.href} class="text-gray-400 hover:text-white text-sm transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
