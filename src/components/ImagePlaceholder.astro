interface ImagePlaceholderProps {
  width?: number;
  height?: number;
  class?: string;
}

const { 
  width = 800, 
  height = 600, 
  class: className = '' 
} = Astro.props;
---

<div 
  class={`animate-pulse bg-gray-200 ${className}`}
  style={{ width: `${width}px`, height: `${height}px` }}
>
  <svg 
    width={width} 
    height={height} 
    viewBox={`0 0 ${width} ${height}`} 
    xmlns="http://www.w3.org/2000/svg"
    class="opacity-30"
  >
    <rect 
      x="0" 
      y="0" 
      width={width} 
      height={height} 
      fill="currentColor"
      class="text-gray-300"
    />
    <text 
      x={width / 2} 
      y={height / 2} 
      textAnchor="middle" 
      dominantBaseline="middle"
      class="text-gray-400"
      style={{ fontSize: `${Math.min(width, height) * 0.1}px` }}
    >
      Image Loading...
    </text>
  </svg>
</div>
