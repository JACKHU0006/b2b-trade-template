---
import MainLayout from '../layouts/MainLayout.astro';
import { ArrowRight, TrendingUp, Award, Globe, Shield, Zap } from '@lucide/astro';
import { products } from '../data/products';
import { news } from '../data/news';

const locale = 'en';
const localizedProducts = products.slice(0, 4);
const localizedNews = news.slice(0, 3);
---

<MainLayout 
  title="FableTech Group - Industrial Metal Products Manufacturer" 
  description="Leading manufacturer of industrial metal products. High-quality steel, aluminum, copper, and titanium solutions for global markets."
  locale={locale}
>
  <section class="bg-gradient-to-r from-primary to-primary-dark text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center justify-between">
        <div class="flex-1 text-center lg:text-left mb-8 lg:mb-0">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Premium Industrial<br />
            <span class="text-secondary">Metal Products</span>
          </h1>
          <p class="text-lg text-gray-200 mb-8 max-w-xl mx-auto lg:mx-0">
            Leading manufacturer of steel, aluminum, copper, and titanium products. 
            Serving global markets with quality, reliability, and innovation.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="/products" class="inline-flex items-center justify-center px-8 py-4 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition-colors">
              View Products
              <ArrowRight class="ml-2 h-5 w-5" />
            </a>
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
              Get a Quote
            </a>
          </div>
        </div>
        <div class="flex-1 flex justify-center">
          <div class="relative">
            <div class="w-80 h-80 bg-white/10 rounded-full flex items-center justify-center">
              <div class="w-64 h-64 bg-white/5 rounded-full flex items-center justify-center">
                <div class="text-center">
                  <div class="text-5xl font-bold">25+</div>
                  <div class="text-gray-300">Years Experience</div>
                </div>
              </div>
            </div>
            <div class="absolute -top-4 -right-4 bg-secondary rounded-full p-4">
              <TrendingUp class="h-6 w-6" />
            </div>
            <div class="absolute -bottom-4 -left-4 bg-success rounded-full p-4">
              <Award class="h-6 w-6" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">50+</div>
          <div class="text-gray-600">Countries Served</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">500+</div>
          <div class="text-gray-600">Global Clients</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">10K+</div>
          <div class="text-gray-600">Products Delivered</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-bold text-primary mb-2">99%</div>
          <div class="text-gray-600">Customer Satisfaction</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Why Choose Us</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          We are committed to providing the highest quality metal products with exceptional service and support.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
          <div class="bg-primary/10 rounded-full p-4 mb-4">
            <Shield class="h-8 w-8 text-primary" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Quality Assurance</h3>
          <p class="text-gray-600">ISO 9001:2015 certified. Every product undergoes rigorous quality checks.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
          <div class="bg-secondary/10 rounded-full p-4 mb-4">
            <Globe class="h-8 w-8 text-secondary" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Global Reach</h3>
          <p class="text-gray-600">Exporting to 50+ countries worldwide with reliable logistics.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
          <div class="bg-success/10 rounded-full p-4 mb-4">
            <Zap class="h-8 w-8 text-success" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Fast Delivery</h3>
          <p class="text-gray-600">Efficient production and shipping ensure timely delivery.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
          <div class="bg-accent/10 rounded-full p-4 mb-4">
            <Award class="h-8 w-8 text-accent" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Expert Support</h3>
          <p class="text-gray-600">Dedicated technical team available 24/7 to assist you.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-center mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Featured Products</h2>
          <p class="text-gray-600">Explore our most popular products</p>
        </div>
        <a href="/products" class="mt-4 md:mt-0 inline-flex items-center text-primary font-semibold hover:underline">
          View All Products
          <ArrowRight class="ml-2 h-5 w-5" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {localizedProducts.map((product) => (
          <div key={product.id} class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 bg-gray-200 flex items-center justify-center">
              <img src={product.images[0]} alt={`${product.name[locale]} - FableTech Group Industrial Metal Products`} class="w-full h-full object-cover" />
            </div>
            <div class="p-6">
              <h3 class="text-lg font-semibold mb-2">{product.name[locale]}</h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">{product.description[locale]}</p>
              <div class="flex items-center justify-between">
                <span class="text-xl font-bold text-primary">${product.price.toFixed(2)}</span>
                <a href={`/products/${product.id}`} class="text-secondary font-medium hover:underline">
                  View Details
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-center mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Latest News</h2>
          <p class="text-gray-600">Stay updated with our latest news and events</p>
        </div>
        <a href="/news" class="mt-4 md:mt-0 inline-flex items-center text-primary font-semibold hover:underline">
          View All News
          <ArrowRight class="ml-2 h-5 w-5" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {localizedNews.map((item) => (
          <div key={item.id} class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 bg-gray-200 flex items-center justify-center">
              <img src={item.image} alt={item.title[locale]} class="w-full h-full object-cover" />
            </div>
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full mb-3">
                {item.category}
              </span>
              <h3 class="text-lg font-semibold mb-2">{item.title[locale]}</h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">{item.summary[locale]}</p>
              <a href={`/news/${item.id}`} class="text-secondary font-medium hover:underline">
                Read More
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Get Started?</h2>
        <p class="text-gray-200 mb-8 max-w-2xl mx-auto">
          Contact us today to discuss your requirements and get a personalized quote.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition-colors">
            Contact Us
            <ArrowRight class="ml-2 h-5 w-5" />
          </a>
          <a href="/products" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
            Browse Products
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
