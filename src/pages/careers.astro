---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Careers & Partnership - FableTech Group" description="Join FableTech Group! Explore career opportunities and partnership programs in our global B2B network." locale="en">
  <div class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Careers & Partnership</h1>
        <p class="text-xl text-gray-600">Join our global team and build your future with FableTech Group</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Join Our Team</h2>
          <p class="text-gray-600 mb-6">
            We're always looking for talented individuals to join our international team. 
            At FableTech Group, you'll work with cutting-edge technology and global partners.
          </p>
          
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Open Positions</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="bg-primary text-white text-xs px-2 py-1 rounded mr-3">Full-time</span>
              <div>
                <strong class="text-gray-900">International Sales Manager</strong>
                <p class="text-sm text-gray-500">Remote / Shanghai, China</p>
              </div>
            </li>
            <li class="flex items-start">
              <span class="bg-primary text-white text-xs px-2 py-1 rounded mr-3">Full-time</span>
              <div>
                <strong class="text-gray-900">Product Engineer</strong>
                <p class="text-sm text-gray-500">Shanghai, China</p>
              </div>
            </li>
            <li class="flex items-start">
              <span class="bg-blue-500 text-white text-xs px-2 py-1 rounded mr-3">Remote</span>
              <div>
                <strong class="text-gray-900">Regional Sales Representative</strong>
                <p class="text-sm text-gray-500">Europe / Americas / Asia</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Partnership Programs</h2>
          <p class="text-gray-600 mb-6">
            We offer various partnership opportunities for distributors, agents, and 
            strategic partners worldwide.
          </p>
          
          <div class="space-y-4">
            <div class="border-l-4 border-primary pl-4">
              <h3 class="font-semibold text-gray-900">Distributor Partnership</h3>
              <p class="text-sm text-gray-600">Exclusive distribution rights in designated regions with volume-based pricing.</p>
            </div>
            <div class="border-l-4 border-secondary pl-4">
              <h3 class="font-semibold text-gray-900">OEM/ODM Cooperation</h3>
              <p class="text-sm text-gray-600">Custom manufacturing partnerships with your brand requirements.</p>
            </div>
            <div class="border-l-4 border-accent pl-4">
              <h3 class="font-semibold text-gray-900">Strategic Alliance</h3>
              <p class="text-sm text-gray-600">Long-term partnerships for joint R&D and market development.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-8 mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Benefits & Culture</h2>
        <div class="grid md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-3xl mb-2">🌍</div>
            <h3 class="font-semibold text-gray-900">Global Opportunities</h3>
            <p class="text-sm text-gray-600">Work with international teams and clients</p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">📈</div>
            <h3 class="font-semibold text-gray-900">Career Growth</h3>
            <p class="text-sm text-gray-600">Clear advancement paths and training</p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">💼</div>
            <h3 class="font-semibold text-gray-900">Competitive Benefits</h3>
            <p class="text-sm text-gray-600">Attractive compensation packages</p>
          </div>
          <div class="text-center">
            <div class="text-3xl mb-2">🎯</div>
            <h3 class="font-semibold text-gray-900">Innovation Focus</h3>
            <p class="text-sm text-gray-600">Work on cutting-edge B2B solutions</p>
          </div>
        </div>
      </div>

      <div class="bg-primary text-white rounded-lg shadow-md p-8 text-center">
        <h2 class="text-2xl font-bold mb-4">Ready to Join Us?</h2>
        <p class="mb-6">
          Send your resume and cover letter to 
          <a href="mailto:careers@fabletech.com" class="underline">careers@fabletech.com</a>
        </p>
        <a href="/contact" class="inline-block bg-white text-primary font-semibold px-6 py-3 rounded-lg hover:bg-gray-100 transition-colors">
          Contact Us Today
        </a>
      </div>
    </div>
  </div>
</MainLayout>
