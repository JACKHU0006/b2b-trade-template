---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="404 - Page Not Found - FableTech Group" description="The page you're looking for doesn't exist." locale="en">
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center">
      <div class="text-9xl font-bold text-gray-200 mb-4">404</div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Page Not Found</h1>
      <p class="text-gray-600 mb-8">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-block bg-primary text-white font-semibold px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors">
          Return Home
        </a>
        <a href="/contact" class="inline-block border-2 border-primary text-primary font-semibold px-6 py-3 rounded-lg hover:bg-primary hover:text-white transition-colors">
          Contact Us
        </a>
      </div>
      
      <div class="mt-12">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Links</h2>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/products" class="text-primary hover:underline">Products</a>
          <a href="/about" class="text-primary hover:underline">About Us</a>
          <a href="/service" class="text-primary hover:underline">Services</a>
          <a href="/faq" class="text-primary hover:underline">FAQ</a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
