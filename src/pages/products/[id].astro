---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import ProductSchema from '../../components/ProductSchema.astro';
import { ArrowLeft, Package, FileText, Download, CheckCircle } from '@lucide/astro';
import { products, getProductCategories } from '../../data/products';
import { supabase, getCurrentUser } from '../../lib/supabase';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const locale = 'en';
const { product } = Astro.props;
const user = supabase ? await getCurrentUser() : null;
const isAuthenticated = !!user;

const categories = getProductCategories();
const categoryProducts = products.filter(p => p.category === product.category && p.id !== product.id).slice(0, 4);

const breadcrumbItems = [
  { name: 'Products', href: '/products' },
  { name: product.category, href: `/products?category=${product.category}` },
  { name: product.name[locale], href: `/products/${product.id}` }
];
---

<MainLayout 
  title={`${product.name[locale]} - FableTech Group`} 
  description={product.description[locale]}
  locale={locale}
  image={product.images[0]}
>
  <Breadcrumbs items={breadcrumbItems} locale={locale} />
  
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center mb-8">
        <a href="/products" class="inline-flex items-center text-gray-600 hover:text-primary transition-colors">
          <ArrowLeft class="h-5 w-5 mr-2" />
          Back to Products
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <div>
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="aspect-square relative">
              <img 
                src={product.images[0]} 
                alt={`${product.name[locale]} - FableTech Group ${product.category}`}
                class="w-full h-full object-cover"
              />
              {product.isPrivate && !isAuthenticated && (
                <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                  <div class="text-center text-white">
                    <Package class="h-16 w-16 mx-auto mb-4" />
                    <p class="text-lg font-semibold">Members Only</p>
                    <p class="text-sm">Login to view this product</p>
                  </div>
                </div>
              )}
            </div>
          </div>
          
          {product.images.length > 1 && (
            <div class="mt-4 flex gap-4">
              {product.images.slice(1).map((image, idx) => (
                <div key={idx} class="w-24 h-24 rounded-lg overflow-hidden">
                  <img src={image} alt={`${product.name[locale]} view ${idx + 2}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
          )}
        </div>

        <div>
          <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full mb-4">
            {product.category}
          </span>
          <h1 class="text-4xl font-bold mb-4">{product.name[locale]}</h1>
          
          {isAuthenticated ? (
            <div class="mb-6">
              <span class="text-3xl font-bold text-primary">${product.price.toFixed(2)}</span>
              <span class="text-gray-600 ml-2">per unit</span>
            </div>
          ) : (
            <div class="mb-6 p-4 bg-gray-50 rounded-lg">
              <p class="text-gray-600 mb-2">
                <a href="/auth/login" class="text-primary font-semibold hover:underline">Sign in</a> to view pricing
              </p>
              <a href="/auth/register" class="text-sm text-gray-500 hover:text-primary">
                Create an account to get wholesale pricing →
              </a>
            </div>
          )}

          <div class="prose prose-lg max-w-none mb-6">
            <p class="text-gray-600">{product.description[locale]}</p>
          </div>

          <div class="mb-8">
            <h3 class="text-lg font-semibold mb-4">Specifications</h3>
            <div class="bg-gray-50 rounded-lg p-6">
              <dl class="grid grid-cols-2 gap-4">
                {Object.entries(product.specs).map(([key, value]) => (
                  <div key={key}>
                    <dt class="text-sm font-medium text-gray-500 capitalize">{key.replace(/([A-Z])/g, ' $1').trim()}</dt>
                    <dd class="text-base font-semibold text-gray-900">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          {isAuthenticated && (
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <button class="flex-1 px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-colors">
                Add to Quote
              </button>
              <button class="flex-1 px-6 py-3 bg-secondary text-white rounded-lg font-semibold hover:bg-secondary/90 transition-colors">
                Request Sample
              </button>
            </div>
          )}

          <div class="border-t pt-6">
            <div class="space-y-3">
              <div class="flex items-center gap-2">
                <CheckCircle class="h-5 w-5 text-green-500" />
                <span class="text-sm text-gray-600">ISO 9001:2015 Certified</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle class="h-5 w-5 text-green-500" />
                <span class="text-sm text-gray-600">Global shipping available</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle class="h-5 w-5 text-green-500" />
                <span class="text-sm text-gray-600">Custom specifications available</span>
              </div>
              <div class="flex items-center gap-2">
                <FileText class="h-5 w-5 text-primary" />
                <a href="#" class="text-sm text-primary hover:underline flex items-center gap-2">
                  <Download class="h-4 w-4" />
                  Download Technical Datasheet (PDF)
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      {categoryProducts.length > 0 && (
        <section class="py-12 border-t">
          <h2 class="text-3xl font-bold mb-8">Related Products</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {categoryProducts.map((relatedProduct) => (
              <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <div class="h-48 bg-gray-200">
                  <img 
                    src={relatedProduct.images[0]} 
                    alt={relatedProduct.name[locale]}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="p-4">
                  <h3 class="font-semibold mb-2">{relatedProduct.name[locale]}</h3>
                  <p class="text-sm text-gray-600 mb-3 line-clamp-2">{relatedProduct.description[locale]}</p>
                  <a href={`/products/${relatedProduct.id}`} class="text-primary font-medium text-sm hover:underline">
                    View Details →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="py-12 bg-gray-50 rounded-xl mt-12">
        <div class="max-w-3xl mx-auto px-4">
          <h2 class="text-2xl font-bold mb-6 text-center">Have Questions About This Product?</h2>
          <p class="text-gray-600 text-center mb-8">
            Our team of experts is ready to help you find the right solution for your needs.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary/90 transition-colors text-center">
              Contact Our Team
            </a>
            <a href="/faq" class="px-6 py-3 bg-white text-primary border-2 border-primary rounded-lg font-semibold hover:bg-gray-50 transition-colors text-center">
              View FAQ
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

  {isAuthenticated && (
    <ProductSchema 
      name={product.name[locale]}
      description={product.description[locale]}
      image={product.images[0]}
      sku={product.id}
      price={product.price}
      category={product.category}
    />
  )}
</MainLayout>
