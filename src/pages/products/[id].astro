---
import MainLayout from '../../layouts/MainLayout.astro';
import { ArrowLeft, Download, ShoppingCart, Lock } from '@lucide/astro';
import { getProductById } from '../../data/products';

export async function getStaticPaths() {
  const products = [
    { id: 'prod-001' },
    { id: 'prod-002' },
    { id: 'prod-003' },
    { id: 'prod-004' },
    { id: 'prod-005' },
    { id: 'prod-006' },
  ];
  return products.map(({ id }) => ({
    params: { id },
  }));
}

const locale = 'en';
const product = getProductById(Astro.params.id as string);
---

{product && (
  <MainLayout 
    title={`${product.name[locale]} - FableTech Group`} 
    description={product.description[locale]}
    locale={locale}
  >
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center mb-8">
          <a href="/products" class="inline-flex items-center text-gray-600 hover:text-primary transition-colors">
            <ArrowLeft class="h-5 w-5 mr-2" />
            Back to Products
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="h-96 bg-gray-200 flex items-center justify-center relative">
              {product.isPrivate && (
                <div class="absolute top-4 right-4 bg-warning text-white px-3 py-2 rounded-full flex items-center">
                  <Lock class="h-4 w-4 mr-2" />
                  Login required
                </div>
              )}
              <img src={product.images[0]} alt={product.name[locale]} class="w-full h-full object-cover" />
            </div>
          </div>

          <div>
            <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-sm font-medium rounded-full mb-4">
              {product.category}
            </span>
            <h1 class="text-3xl font-bold mb-4">{product.name[locale]}</h1>
            <p class="text-gray-600 mb-6">{product.description[locale]}</p>

            <div class="bg-gray-50 rounded-xl p-6 mb-6">
              <h3 class="font-semibold mb-4">Product Specifications</h3>
              <div class="grid grid-cols-2 gap-4">
                {Object.entries(product.specs).map(([key, value]) => (
                  <div key={key} class="flex justify-between">
                    <span class="text-gray-500">{key}</span>
                    <span class="font-medium">{value}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-between mb-6">
              <div>
                <span class="text-gray-500 text-sm">Price</span>
                <div class="text-3xl font-bold text-primary">${product.price.toFixed(2)}</div>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <button class="flex-1 flex items-center justify-center px-6 py-4 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg transition-colors">
                <ShoppingCart class="mr-2 h-5 w-5" />
                Add to Inquiry
              </button>
              <button class="px-6 py-4 border-2 border-primary text-primary font-semibold rounded-lg hover:bg-primary hover:text-white transition-colors">
                <Download class="mr-2 h-5 w-5" />
                Download Specs
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </MainLayout>
)}
