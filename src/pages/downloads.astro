---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Download Center - FableTech Group" description="Download FableTech product catalogs, specifications, and marketing materials." locale="en">
  <div class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Download Center</h1>
        <p class="text-xl text-gray-600">Access product catalogs, specifications, and marketing materials</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="text-3xl mb-4">📦</div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">Product Catalogs</h2>
          <p class="text-gray-600 mb-4">Complete product range overview in multiple languages</p>
          <ul class="space-y-2">
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>📄</span> Full Product Catalog 2024 (EN)
              </a>
            </li>
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>📄</span> Product Catalog (DE)
              </a>
            </li>
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>📄</span> Product Catalog (FR)
              </a>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="text-3xl mb-4">📋</div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">Technical Specs</h2>
          <p class="text-gray-600 mb-4">Detailed specifications and engineering data sheets</p>
          <ul class="space-y-2">
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>📊</span> Technical Specifications Guide
              </a>
            </li>
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>📊</span> Material Safety Data Sheets
              </a>
            </li>
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>📊</span> Quality Certifications
              </a>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="text-3xl mb-4">🎨</div>
          <h2 class="text-xl font-bold text-gray-900 mb-2">Marketing Materials</h2>
          <p class="text-gray-600 mb-4">Branding assets and promotional content</p>
          <ul class="space-y-2">
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>🖼️</span> Brand Guidelines
              </a>
            </li>
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>🖼️</span> Product Images Package
              </a>
            </li>
            <li>
              <a href="#" class="text-primary hover:underline flex items-center">
                <span>🎬</span> Company Presentation
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-8">
        <p class="text-blue-800">
          <strong>Need customized materials?</strong> Contact our sales team for branded content, 
          custom specifications, or bulk downloads.
        </p>
      </div>

      <div class="bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Featured Downloads</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="border rounded-lg p-4 flex items-center">
            <div class="bg-gray-100 rounded p-3 mr-4">
              <span class="text-2xl">📚</span>
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-gray-900">2024 Product Brochure</h3>
              <p class="text-sm text-gray-500">PDF | 15.2 MB | Updated: Jan 2024</p>
            </div>
            <button class="bg-primary text-white px-4 py-2 rounded hover:bg-primary/90 transition-colors">
              Download
            </button>
          </div>
          <div class="border rounded-lg p-4 flex items-center">
            <div class="bg-gray-100 rounded p-3 mr-4">
              <span class="text-2xl">🏭</span>
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-gray-900">Factory Capability Report</h3>
              <p class="text-sm text-gray-500">PDF | 8.5 MB | Updated: Dec 2023</p>
            </div>
            <button class="bg-primary text-white px-4 py-2 rounded hover:bg-primary/90 transition-colors">
              Download
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
