---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const locale = 'en';

const breadcrumbItems = [
  { name: 'Sitemap', href: '/sitemap' }
];

const siteMap = [
  {
    title: 'Main Pages',
    links: [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About Us' },
      { href: '/products', label: 'Products' },
      { href: '/news', label: 'News & Events' },
      { href: '/factory', label: 'Our Factory' },
      { href: '/service', label: 'Services' },
      { href: '/faq', label: 'FAQ' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Product Categories',
    links: [
      { href: '/products?category=Steel Products', label: 'Steel Products' },
      { href: '/products?category=Valves', label: 'Valves' },
      { href: '/products?category=Aluminum', label: 'Aluminum' },
      { href: '/products?category=Copper', label: 'Copper' },
      { href: '/products?category=Brass', label: 'Brass' },
      { href: '/products?category=Titanium', label: 'Titanium' },
    ],
  },
  {
    title: 'Legal & Support',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
      { href: '/cookies', label: 'Cookie Policy' },
      { href: '/returns', label: 'Returns Policy' },
      { href: '/shipping', label: 'Shipping Information' },
      { href: '/support', label: 'Support Center' },
    ],
  },
];
---

<MainLayout 
  title="Sitemap - FableTech Group" 
  description="Complete sitemap of FableTech Group website. Navigate through all our pages including products, services, about us, and more."
  locale={locale}
>
  <Breadcrumbs items={breadcrumbItems} locale={locale} />
  
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Website Sitemap</h1>
        <p class="text-lg text-gray-200 max-w-2xl mx-auto">
          Navigate through our complete website structure. Find all pages, products, and resources in one place.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {siteMap.map((section) => (
          <div key={section.title} class="bg-white rounded-xl shadow-lg p-6">
            <h2 class="text-2xl font-bold mb-6 text-gray-900 border-b-2 border-primary pb-3">
              {section.title}
            </h2>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li key={link.label}>
                  <a href={link.href} class="flex items-center text-gray-600 hover:text-primary transition-colors group">
                    <svg class="w-4 h-4 mr-2 text-gray-400 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-16 bg-gradient-to-r from-primary to-secondary rounded-xl p-8 text-white text-center">
        <h2 class="text-3xl font-bold mb-4">Looking for Something Specific?</h2>
        <p class="text-lg mb-6 opacity-90 max-w-2xl mx-auto">
          Can't find what you're looking for? Contact our team and we'll help you locate it quickly.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
            Contact Us
          </a>
          <a href="/products" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
            Browse Products
          </a>
        </div>
      </div>

      <div class="mt-12 bg-blue-50 rounded-xl p-8">
        <h3 class="text-xl font-bold text-blue-900 mb-4">XML Sitemap</h3>
        <p class="text-blue-800 mb-4">
          For search engines and technical users, we also provide an XML version of our sitemap.
        </p>
        <a href="/sitemap.xml" class="inline-flex items-center text-blue-900 font-semibold hover:underline">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download XML Sitemap
        </a>
      </div>
    </div>
  </section>
</MainLayout>
