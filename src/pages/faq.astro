---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { ChevronDown, HelpCircle } from '@lucide/astro';

const locale = 'en';

const faqs = [
  {
    question: 'What is your minimum order quantity?',
    answer: 'Our minimum order quantity (MOQ) varies depending on the product type and material. For most standard steel, aluminum, and copper products, the MOQ is 100 pieces. For custom orders or specialized materials like titanium, please contact our sales team for specific requirements. We also offer flexible MOQ options for established clients with recurring orders.'
  },
  {
    question: 'Do you offer custom manufacturing?',
    answer: 'Absolutely! We offer comprehensive custom manufacturing services tailored to your exact specifications. Our experienced engineering team can assist with product design, material selection, and prototype development. We work with a wide range of metals including steel, stainless steel, aluminum, copper, brass, and titanium. Whether you need small precision components or large structural parts, we have the capabilities to deliver.'
  },
  {
    question: 'What is your typical delivery time?',
    answer: 'Delivery time depends on product type, quantity, and complexity. Standard in-stock products typically ship within 7-14 business days. Custom manufactured items may take 2-6 weeks depending on the project scope. For large volume orders, we can arrange staggered shipments. We provide detailed delivery schedules with every order confirmation and keep you updated throughout the production process.'
  },
  {
    question: 'What payment methods do you accept?',
    answer: 'We accept multiple secure payment methods: T/T (Telegraphic Transfer), L/C (Letter of Credit), PayPal, major credit cards (Visa, MasterCard, American Express), and bank transfers. For first-time orders, we typically require 30% deposit upfront with the balance due before shipment. Established clients may qualify for extended payment terms. All transactions are encrypted and secure.'
  },
  {
    question: 'Do you provide product samples?',
    answer: 'Yes, we can provide samples for most of our products to help you evaluate quality and suitability. Sample costs and shipping fees apply and are typically refundable with your first bulk order. Sample availability varies by product – standard items usually ship within 3-5 days, while custom samples may take 1-2 weeks. Please contact our sales team with your specific sample requirements.'
  },
  {
    question: 'What certifications do your products have?',
    answer: 'All our manufacturing facilities and quality management systems are ISO 9001:2015 certified. Depending on the product line and destination, we can provide additional certifications including CE marking, SGS testing reports, RoHS compliance, material certifications (Mill Test Reports), and industry-specific certifications. Certificates are available upon request with your order.'
  },
  {
    question: 'What is your return and warranty policy?',
    answer: 'We stand behind the quality of our products with a comprehensive warranty. All products come with a standard 12-month warranty against manufacturing defects. If you receive defective or incorrect items, please contact us within 7 days of delivery with photos and a description of the issue. We will arrange for replacement, repair, or refund at our discretion. Custom products have specific warranty terms outlined in your order agreement.'
  },
  {
    question: 'Do you offer international shipping?',
    answer: 'Yes! We proudly serve customers in over 60 countries worldwide. We work with all major international shipping carriers including DHL, FedEx, UPS, and ocean freight providers. We offer flexible shipping options from express delivery to economical ocean freight. Our logistics team handles all export documentation and can arrange door-to-door delivery. Shipping costs are calculated based on destination, weight, and dimensions.'
  },
  {
    question: 'What materials do you work with?',
    answer: 'We specialize in a wide range of industrial metals: Carbon Steel (A36, 1018, 4140), Stainless Steel (304, 316), Aluminum (6061, 5052, 6063), Copper, Brass, Titanium (Grade 2, Grade 5), and various alloy steels. We source materials from reputable suppliers and provide full material traceability. For specialty applications, we can work with customer-specified materials.'
  },
  {
    question: 'Can you handle large volume orders?',
    answer: 'Absolutely! With our expanded production facilities and automated manufacturing lines, we have the capacity to handle large volume orders efficiently. Our production capacity allows us to scale up manufacturing while maintaining strict quality standards. We work closely with customers to develop production schedules that meet their delivery requirements. For annual or recurring orders, we can establish dedicated inventory and pricing agreements.'
  },
  {
    question: 'What quality control measures do you have in place?',
    answer: 'We have rigorous quality control procedures at every stage: incoming material inspection and testing, in-process monitoring at key production points, final dimensional inspection, functional testing, and pre-shipment verification. Our QC team uses advanced inspection equipment including coordinate measuring machines (CMM), spectrometers, and hardness testers. Every product undergoes multiple checks before shipping.'
  },
  {
    question: 'How do I get a quote for my project?',
    answer: 'Getting a quote is easy! You can: 1) Use our online inquiry form on the Contact page, 2) Email us directly with your specifications, 3) Contact our sales team via WhatsApp or phone, 4) Request a consultation with our engineering team. For the most accurate quote, please provide drawings, material specifications, quantities, delivery timeline, and any special requirements. We typically respond within 24-48 hours with detailed pricing.'
  },
];

const breadcrumbItems = [
  { name: 'FAQ', href: '/faq' }
];
---

<MainLayout 
  title="FAQ - FableTech Group" 
  description="Frequently asked questions about our products, services, and ordering process."
  locale={locale}
>
  <Breadcrumbs items={breadcrumbItems} locale={locale} />
  
  <FAQSchema questions={faqs} />
  
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
        <p class="text-lg text-gray-200">
          Find answers to common questions about our products and services
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        {faqs.map((faq, index) => (
          <div key={index} class="bg-white rounded-xl shadow-lg overflow-hidden">
            <button
              onClick={() => toggleFaq(index)}
              class="w-full px-6 py-5 flex items-center justify-between text-left hover:bg-gray-50 transition-colors"
            >
              <div class="flex items-center">
                <HelpCircle class="h-5 w-5 text-primary mr-3" />
                <span class="font-semibold text-gray-900">{faq.question}</span>
              </div>
              <ChevronDown 
                id={`chevron-${index}`}
                class="h-5 w-5 text-gray-500 transition-transform" 
              />
            </button>
            <div 
              id={`answer-${index}`}
              class="overflow-hidden transition-all duration-300 max-h-0"
    >
      <div class="px-6 pb-5 pt-3 text-gray-600 pl-14">
        {faq.answer}
      </div>
    </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-gray-600 mb-4">Didn't find your answer?</p>
        <a href="/contact" class="inline-flex items-center text-primary font-semibold hover:underline">
          Contact our support team
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const firstChevron = document.getElementById('chevron-0');
    const firstAnswer = document.getElementById('answer-0');
    if (firstChevron && firstAnswer) {
      firstChevron.style.transform = 'rotate(180deg)';
      firstAnswer.style.maxHeight = '500px';
    }
  });

  function toggleFaq(index) {
    const chevron = document.getElementById(`chevron-${index}`);
    const answer = document.getElementById(`answer-${index}`);
    
    if (chevron && answer) {
      if (answer.style.maxHeight === '500px') {
        chevron.style.transform = 'rotate(0deg)';
        answer.style.maxHeight = '0';
      } else {
        chevron.style.transform = 'rotate(180deg)';
        answer.style.maxHeight = '500px';
      }
    }
  }
</script>
