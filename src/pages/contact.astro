---
import MainLayout from '../layouts/MainLayout.astro';
import ReCAPTCHA from '../components/ReCAPTCHA.astro';
import { MapPin, Phone, Mail, Clock, Send, CheckCircle } from '@lucide/astro';

const locale = 'en';

const contactInfo = [
  { icon: MapPin, label: 'Address', value: '123 Industrial Road, Shanghai, China' },
  { icon: Phone, label: 'Phone', value: '+86 21 1234 5678' },
  { icon: Mail, label: 'Email', value: 'contact@fabletech.com' },
  { icon: Clock, label: 'Hours', value: 'Mon-Fri: 8:00 - 18:00' },
];
---

<MainLayout 
  title="Contact Us - FableTech Group" 
  description="Get in touch with our team for inquiries, quotes, or support."
  locale={locale}
>
  <section class="bg-primary text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
        <p class="text-lg text-gray-200">
          Get in touch with our team for inquiries, quotes, or support
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold mb-8">Get in Touch</h2>
          <div class="space-y-6">
            {contactInfo.map((item) => (
              <div key={item.label} class="flex items-start">
                <div class="bg-primary/10 rounded-full p-3 mr-4">
                  <item.icon class="h-6 w-6 text-primary" />
                </div>
                <div>
                  <div class="font-semibold text-gray-900">{item.label}</div>
                  <div class="text-gray-600">{item.value}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-8">Send us a Message</h2>
          <div id="form-container">
            <form id="contact-form" class="space-y-4" method="POST">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                  <input
                    type="text"
                    name="name"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Company</label>
                  <input
                    type="text"
                    name="company"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Company name"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                  <input
                    type="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="your@email.com"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                  <input
                    type="tel"
                    name="phone"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="+1 234 567 890"
                  />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
                <textarea
                  name="message"
                  required
                  rows={5}
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary resize-none"
                  placeholder="How can we help you?"
                ></textarea>
              </div>
              <div class="g-recaptcha-container">
                <ReCAPTCHA />
              </div>
              <button
                type="submit"
                class="w-full flex items-center justify-center px-8 py-4 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg transition-colors"
              >
                <Send class="mr-2 h-5 w-5" />
                Send Message
              </button>
            </form>
          </div>
          <div id="success-message" class="bg-green-50 border border-green-200 rounded-xl p-8 text-center hidden">
            <CheckCircle class="h-12 w-12 text-green-600 mx-auto mb-4" />
            <h3 class="text-xl font-semibold text-green-600 mb-2">Message Sent!</h3>
            <p class="text-gray-600">Thank you for your inquiry. We will get back to you within 24 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const formContainer = document.getElementById('form-container');
    const successMessage = document.getElementById('success-message');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      form.style.display = 'none';
      successMessage.style.display = 'block';
      setTimeout(() => {
        successMessage.style.display = 'none';
        form.style.display = 'block';
        form.reset();
      }, 5000);
    });
  });
</script>
