---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Global Agent Program - FableTech Group" description="Become a FableTech Group global agent. Exclusive partnership opportunities for B2B distributors worldwide." locale="en">
  <div class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-block bg-primary text-white text-sm px-4 py-1 rounded-full mb-4">Global Agent Program</div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Become a FableTech Global Agent</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Join our worldwide network of exclusive agents and represent premium B2B industrial products in your region
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Exclusive Territory</h3>
          <p class="text-gray-600">
            Become the exclusive FableTech representative in your designated region with protected market rights.
          </p>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-4xl mb-4">💰</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Competitive Commission</h3>
          <p class="text-gray-600">
            Earn attractive commissions on all sales with volume-based bonuses and performance incentives.
          </p>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-4xl mb-4">🤝</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Full Support</h3>
          <p class="text-gray-600">
            Access marketing materials, technical training, dedicated account management, and priority fulfillment.
          </p>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-8 mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Agent Benefits Package</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Sales Support</h3>
            <ul class="space-y-2 text-gray-600">
              <li>✓ Dedicated sales collateral in local languages</li>
              <li>✓ Sample products for demonstrations</li>
              <li>✓ Competitive wholesale pricing</li>
              <li>✓ Flexible minimum order quantities</li>
              <li>✓ Quick response quotation service</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Marketing & Training</h3>
            <ul class="space-y-2 text-gray-600">
              <li>✓ Digital marketing assets and templates</li>
              <li>✓ Product training and certification</li>
              <li>✓ Trade show support and sponsorship</li>
              <li>✓ Lead generation in your territory</li>
              <li>✓ Co-marketing opportunities</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="bg-primary text-white rounded-lg shadow-md p-8 mb-12">
        <div class="grid md:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-3xl font-bold">50+</div>
            <div class="text-sm opacity-80">Countries</div>
          </div>
          <div>
            <div class="text-3xl font-bold">200+</div>
            <div class="text-sm opacity-80">Active Agents</div>
          </div>
          <div>
            <div class="text-3xl font-bold">95%</div>
            <div class="text-sm opacity-80">Retention Rate</div>
          </div>
          <div>
            <div class="text-3xl font-bold">24/7</div>
            <div class="text-sm opacity-80">Support</div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-md p-8 mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Application Requirements</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Basic Requirements</h3>
            <ul class="space-y-2 text-gray-600">
              <li>• Existing B2B distribution network</li>
              <li>• Experience in industrial products sector</li>
              <li>• Professional business registration</li>
              <li>• Commitment to quality customer service</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Preferred Qualifications</h3>
            <ul class="space-y-2 text-gray-600">
              <li>• Established relationships with target customers</li>
              <li>• Technical expertise in product category</li>
              <li>• Warehouse or logistics capabilities</li>
              <li>• After-sales service infrastructure</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="bg-secondary text-white rounded-lg shadow-md p-8 text-center">
        <h2 class="text-2xl font-bold mb-4">Start Your Partnership Today</h2>
        <p class="mb-6">
          Apply now to become a FableTech Global Agent and unlock exclusive market opportunities.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-block bg-white text-secondary font-semibold px-6 py-3 rounded-lg hover:bg-gray-100 transition-colors">
            Submit Application
          </a>
          <a href="/careers" class="inline-block border-2 border-white text-white font-semibold px-6 py-3 rounded-lg hover:bg-white hover:text-secondary transition-colors">
            View All Opportunities
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
