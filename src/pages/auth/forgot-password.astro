---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase';

let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email')?.toString() || '';

  if (!supabase) {
    error = '认证服务暂不可用';
  } else {
    const { error: resetError } = await supabase.auth.resetPasswordForEmail(email);
    if (resetError) {
      error = resetError.message || '重置密码失败';
    } else {
      success = '重置密码链接已发送到您的邮箱';
    }
  }
}

const isAuthenticated = supabase ? await supabase.auth.getUser().then(r => !!r.data.user) : false;
if (isAuthenticated) {
  return Astro.redirect('/dashboard');
}
---

<MainLayout title="Forgot Password - FableTech Group" description="Reset your password" locale="en">
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="bg-white rounded-lg shadow-xl p-8">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center mb-4">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="forgotLogoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#1e40af"/>
                  <stop offset="50%" style="stop-color:#059669"/>
                  <stop offset="100%" style="stop-color:#1e40af"/>
                </linearGradient>
              </defs>
              <circle cx="32" cy="32" r="30" fill="url(#forgotLogoGrad)" opacity="0.1"/>
              <circle cx="32" cy="32" r="28" stroke="url(#forgotLogoGrad)" stroke-width="2" fill="none"/>
              <text x="32" y="26" font-family="Inter, Arial, sans-serif" font-size="14" font-weight="700" text-anchor="middle" fill="url(#forgotLogoGrad)">Fable</text>
            <text x="32" y="42" font-family="Inter, Arial, sans-serif" font-size="14" font-weight="700" text-anchor="middle" fill="url(#forgotLogoGrad)">Tech</text>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900">Forgot Password</h2>
          <p class="text-gray-600 mt-2">Enter your email to reset your password</p>
        </div>

        {success && (
          <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
            {success}
          </div>
        )}

        {error && (
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
            {error}
          </div>
        )}

        <form method="POST" class="space-y-6">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-colors"
              placeholder="your@email.com"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-primary text-white py-3 rounded-lg font-semibold hover:bg-primary/90 transition-colors"
          >
            Send Reset Link
          </button>
        </form>

        <div class="mt-6">
          <a href="/auth/login" class="block w-full text-center py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
            Back to Sign In
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
