# FableTech Group - Environment Variables Template
# Copy this file to .env and replace with your actual values

# ========================================
# SITE CONFIGURATION
# ========================================
SITE_URL=https://fabletech.example.com
SITE_NAME=FableTech Group
COMPANY_NAME=FableTech Group
COMPANY_EMAIL=info@fabletech.com
COMPANY_PHONE=+86 21 1234 5678
COMPANY_ADDRESS=123 Industrial Road, Shanghai, China

# ========================================
# SUPABASE AUTHENTICATION
# ========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# FORMSPREE INQUIRY FORMS
# ========================================
# Get your form ID from: https://formspree.io/dashboard/forms
PUBLIC_FORMSPREE_ID=your-form-id

# ========================================
# MEDUSA E-COMMERCE (Future)
# ========================================
# Configure when you're ready to enable e-commerce
PUBLIC_MEDUSA_API_URL=https://api.medusa-commerce.example.com
PUBLIC_MEDUSA_PUBLISHABLE_KEY=your-publishable-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ========================================
# ANALYTICS & TRACKING
# ========================================
# Google Analytics 4
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel (Facebook)
PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXX

# ========================================
# WHATSAPP CONTACT
# ========================================
# Your WhatsApp business number (without + or spaces)
PUBLIC_WHATSAPP_NUMBER=861234567890
PUBLIC_WHATSAPP_MESSAGE=Hello, I am interested in your products. Can you provide more information?

# ========================================
# FEATURE FLAGS
# ========================================
# Enable/disable features
ENABLE_MEMBER_LOGIN=true
ENABLE_ECOMMERCE=false
ENABLE_GEO_REDIRECT=false
ENABLE_RIGHT_CLICK_PROTECT=false

# ========================================
# SEO CONFIGURATION
# ========================================
SEO_DEFAULT_TITLE=FableTech Group - Professional B2B Industrial Solutions
SEO_DEFAULT_DESCRIPTION=Leading B2B supplier of industrial products with global reach. Quality manufacturing, competitive pricing, and reliable supply chain solutions.
